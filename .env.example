# 复制为 .env 后填写，勿把 .env 提交到 Git。

# ---------- DeepSeek（对话 / RAG 生成）----------
# 密钥与用量: https://platform.deepseek.com/usage
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_CHAT_MODEL=deepseek-chat

# ---------- 火山方舟（多模态向量 POST /embeddings/multimodal，纯文本用 type=text）----------
ARK_API_KEY=
# 需在控制台开通；文档示例：doubao-embedding-vision-250615
# ARK_EMBEDDING_MODEL=doubao-embedding-vision-250615
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 接口支持 1024 或 2048，与文档一致
# ARK_EMBEDDING_DIMENSIONS=2048
