# Copy this file to .env and fill in your own keys.
# Do not commit .env to GitHub.

# ---------- DeepSeek / compatible chat model ----------
# DeepSeek usage and API key: https://platform.deepseek.com/usage
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_CHAT_MODEL=deepseek-chat

# ---------- OpenAI-compatible API, optional ----------
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini

# ---------- Volcengine Ark embedding, optional ----------
ARK_API_KEY=
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ARK_EMBEDDING_MODEL=doubao-embedding-vision-250615
# ARK_EMBEDDING_DIMENSIONS=2048

# ---------- Embedding / Rerank defaults ----------
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
RERANK_MODEL=BAAI/bge-reranker-base

# ---------- Project settings ----------
DEFAULT_TOP_K=5
RERANK_TOP_K=5
MAX_RETRIEVAL_ROUNDS=2
